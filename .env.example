# Environment Configuration Template — Appointment Prep
# Generate a cryptographically secure 32+ character secret using: openssl rand -hex 32
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/appointment_prep
JWT_SECRET=replace_this_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
